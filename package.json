{
  "name": "ledgerline",
  "version": "0.1.0",
  "description": "Payments service with a double-entry ledger, idempotent transfers, transactional-outbox webhooks, risk checks and nightly reconciliation.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "db:start": "node src/scripts/dev-db.ts",
    "migrate": "node src/scripts/migrate.ts",
    "seed": "node src/scripts/seed.ts",
    "start": "node src/main.ts",
    "reconcile": "node src/scripts/reconcile.ts",
    "webhook-sink": "node loadtest/webhook-sink.ts",
    "loadtest": "k6 run loadtest/transfers.js",
    "loadtest:verify": "node loadtest/verify.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "typescript": "^7.0.2"
  }
}
